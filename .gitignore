# Generated by Cargo
/target
debug/

# MCPB build output (scripts/build-mcpb.mjs)
/dist

# Cargo.lock is committed on purpose: this crate ships a binary,
# and a tracked lockfile gives reproducible builds.

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these (debugging information)
*.pdb

# cargo-mutants mutation-testing output
**/mutants.out*/

# Local secrets (config.toml, .env) - never commit; credentials live in
# ~/.config/hetzner-mcp/config.toml, but a repo-local copy used with
# `hetzner-mcp --config ./config.toml` (at any depth) must never land in git.
config.toml
.env
.env.*

# Waykeeper session state - never commit
.waykeeper/

# Browser-automation session junk
.playwright-mcp/

# OS cruft
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# Internal design notes and review transcripts - local only, not published.
docs/
